# === Big-deal radar – helyi titkok ===
# Másold .env.example fájlt .env néven, és töltsd ki.
# A .env SOHA nem kerül a repóba.

# Discord webhook – kötelező a Discord értesítéshez.
# Példa: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# Telegram – opcionális, egyelőre csak előkészített hely.
# A bot tokent a @BotFather-től kapod.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionális beállítások
SITE_URL=https://example.github.io/big-deal-radar/
TZ=Europe/Budapest
LOG_LEVEL=info
